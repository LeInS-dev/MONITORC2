# --- Servidor relay ARGOS Remote Control ---

# Puerto HTTP/WS
PORT=4600

# Interfaz de bind. RECOMENDADO: la IP de Tailscale (p.ej. 100.114.220.80),
# NO 0.0.0.0 aunque el servicio sea "accesible por internet".
BIND_HOST=0.0.0.0

# Token compartido que los dispositivos incluyen al registrarse (enrolamiento).
# Genera uno largo y aleatorio. Sin token válido, un dispositivo no se registra.
ENROLL_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

# Contraseña única del operador para entrar al dashboard.
OPERATOR_PASSWORD=cambia-esta-contrasena

# Secreto para firmar el JWT de sesión del operador (>=32 chars).
JWT_SECRET=cambia-esto-por-al-menos-32-caracteres-aleatorios
